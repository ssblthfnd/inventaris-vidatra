APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:jtAiohnUi1qYaYXp9BNZMoq9kV1tRJiIshZ8rfc68ss=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Dedicated MySQL test database — NEVER the development DB (inventaris_vidatra).
# The domain schema uses MySQL-only features (STORED generated column, CHECK,
# composite FKs, utf8mb4_0900_ai_ci) so SQLite cannot be used.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventaris_vidatra_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=array

# Sanctum SPA stateful auth — tests send Origin: http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
